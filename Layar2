def detect_temporal_anomalies(df, time_col='date', value_col='Death_rate_100k', group_col='WHO_region'):
    """Detect temporal anomalies in time series data"""
    print("\nDetecting temporal anomalies...")
    
    anomalies = []
    
    for group in df[group_col].unique():
        group_data = df[df[group_col] == group].copy()
        group_data = group_data.sort_values(time_col)
        
        if len(group_data) < 10:
            continue
        
        group_data = group_data.dropna(subset=[value_col])
        
        if len(group_data) < 10:
            continue
        
        # Calculate rolling statistics
        window_size = min(7, len(group_data) // 3)
        group_data['rolling_mean'] = group_data[value_col].rolling(window=window_size).mean()
        group_data['rolling_std'] = group_data[value_col].rolling(window=window_size).std()
        
        # Detect anomalies
        group_data['anomaly'] = (
            (group_data[value_col] > group_data['rolling_mean'] + 3 * group_data['rolling_std']) |
            (group_data[value_col] < group_data['rolling_mean'] - 3 * group_data['rolling_std'])
        )
        
        group_anomalies = group_data[group_data['anomaly'] == True]
        if not group_anomalies.empty:
            for _, row in group_anomalies.iterrows():
                anomalies.append({
                    'region': group,
                    'date': row[time_col],
                    'value': row[value_col],
                    'expected_mean': row['rolling_mean'],
                    'expected_std': row['rolling_std'],
                    'deviation': abs(row[value_col] - row['rolling_mean']) / row['rolling_std']
                })
    
    anomalies_df = pd.DataFrame(anomalies)
    
    if not anomalies_df.empty:
        anomalies_df.to_csv(temporal_anomalies_path, index=False)
        print(f"Detected {len(anomalies_df)} temporal anomalies. Saved to {temporal_anomalies_path}")
    
    return anomalies_df

