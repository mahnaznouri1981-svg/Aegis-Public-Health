            negative_count = (df[col] < 0).sum()
            if negative_count > 0:
                validation_results.append({
                    'column': col,
                    'issue': 'negative_values',
                    'count': negative_count,
                    'severity': 'high'
                })
            
            # Check for extremely high values
            max_val = df[col].max()
            if col == 'Death_rate_100k' and max_val > 100:
                validation_results.append({
                    'column': col,
                    'issue': 'extremely_high_values',
                    'max_value': max_val,
                    'severity': 'medium'
                })
            elif col == 'Case_rate_100k' and max_val > 10000:
                validation_results.append({
                    'column': col,
                    'issue': 'extremely_high_values',
                    'max_value': max_val,
                    'severity': 'medium'
                })
    
    # Check temporal consistency for each region
    for region in df['WHO_region'].unique():
        region_data = df[df['WHO_region'] == region].sort_values('date')
        
        if 'Death_rate_100k' in region_data.columns:
            death_rate = region_data['Death_rate_100k'].dropna()
            if len(death_rate) > 1:
                daily_change = death_rate.diff().abs()
                threshold = daily_change.mean() * 10
                sudden_jumps = daily_change[daily_change > threshold]
                
                if not sudden_jumps.empty:
                    validation_results.append({
                        'region': region,
                        'column': 'Death_rate_100k',
                        'issue': 'sudden_jumps',
                        'jump_count': len(sudden_jumps),
                        'max_jump': sudden_jumps.max(),
                        'severity': 'medium'
                    })
    
    validation_df = pd.DataFrame(validation_results)
    if not validation_df.empty:
        validation_df.to_csv(aggregated_validation_path, index=False)
        print("Aggregated data validation results saved.")
    
    return validation_df

