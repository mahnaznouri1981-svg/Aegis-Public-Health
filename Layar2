def test_normality(df, columns=None, alpha=0.05, sample_size=5000):
    """
    Test normality of numeric columns using multiple tests.
    Returns a DataFrame with test results.
    """
    if columns is None:
        columns = df.select_dtypes(include=[np.number]).columns.tolist()
    
    results = []
    
    for col in columns:
        if col not in df.columns:
            continue
            
        # Get sample for large datasets
        data = df[col].dropna()
        if len(data) > sample_size:
            data = data.sample(sample_size, random_state=RANDOM_STATE)
        
        if len(data) < 3:  # Need at least 3 data points
            continue
            
        col_results = {'column': col, 'sample_size': len(data)}
        
        # Shapiro-Wilk test (for n < 5000)
        if len(data) < 5000:
            try:
                stat, p = shapiro(data)
                col_results['shapiro_stat'] = stat
                col_results['shapiro_p'] = p
                col_results['shapiro_normal'] = p > alpha
            except Exception as e:
                col_results['shapiro_error'] = str(e)
        else:
            # For large samples, mark as not tested
            col_results['shapiro_stat'] = None
            col_results['shapiro_p'] = None
            col_results['shapiro_normal'] = None
            col_results['shapiro_note'] = 'Sample size > 5000, test not performed'
        
        # Anderson-Darling test
        try:
            result = anderson(data)
            col_results['anderson_stat'] = result.statistic
            col_results['anderson_critical'] = result.critical_values[2]  # 5% significance
            col_results['anderson_normal'] = result.statistic < result.critical_values[2]
        except Exception as e:
            col_results['anderson_error'] = str(e)
        
        # Kolmogorov-Smirnov test
        try:
            stat, p = kstest(data, 'norm', args=(data.mean(), data.std()))
            col_results['ks_stat'] = stat
            col_results['ks_p'] = p
            col_results['ks_normal'] = p > alpha
        except Exception as e:
            col_results['ks_error'] = str(e)
        
        results.append(col_results)
    
    return pd.DataFrame(results)

def calculate_vif(df, columns=None):
    """
    Calculate Variance Inflation Factor for numeric columns to detect multicollinearity.
    Returns a DataFrame with VIF values.
    """
    if columns is None:
        columns = df.select_dtypes(include=[np.number]).columns.tolist()
    
    # Remove columns with all NaN or zero variance
    valid_columns = []
    for col in columns:
        if col in df.columns and df[col].notna().sum() > 10 and df[col].std() > 0:
            valid_columns.append(col)
    
    if len(valid_columns) < 2:
        return pd.DataFrame({'column': valid_columns, 'vif': [np.nan] * len(valid_columns)})
    
    # Prepare data for VIF calculation
    vif_data = df[valid_columns].copy()
    
    # Fill NaN values with column mean
    for col in vif_data.columns:
        vif_data[col] = vif_data[col].fillna(vif_data[col].mean())
    
    # Calculate VIF for each feature
    vif_results = []
    for i, col in enumerate(vif_data.columns):
        try:
            vif = variance_inflation_factor(vif_data.values, i)
            vif_results.append({'column': col, 'vif': vif})
        except Exception as e:
            vif_results.append({'column': col, 'vif': np.nan, 'error': str(e)})
    
    return pd.DataFrame(vif_results)

def analyze_correlations(df, threshold=0.8, method='pearson'):
    """
    Analyze correlations between numeric columns.
    Returns correlation matrix and highly correlated pairs.
    """
    numeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()
    
    if len(numeric_cols) < 2:
        return pd.DataFrame(), []
    
    # Calculate correlation matrix
    corr_matrix = df[numeric_cols].corr(method=method)
    
    # Find highly correlated pairs
    high_corr_pairs = []
    for i in range(len(numeric_cols)):
        for j in range(i+1, len(numeric_cols)):
            corr_val = corr_matrix.iloc[i, j]
            if abs(corr_val) > threshold:
                high_corr_pairs.append({
                    'feature1': numeric_cols[i],
                    'feature2': numeric_cols[j],
                    'correlation': corr_val
                })
    
    return corr_matrix, high_corr_pairs

def check_expected_correlations(df, expected_pairs):
    """
    Check if expected correlations between indicators are present.
    Returns a DataFrame with correlation results.
    """
    results = []
    
    for pair in expected_pairs:
        col1, col2, expected_direction, min_threshold = pair
        
        if col1 not in df.columns or col2 not in df.columns:
            results.append({
                'feature1': col1,
                'feature2': col2,
                'correlation': np.nan,
                'expected_direction': expected_direction,
                'min_threshold': min_threshold,
                'status': 'missing_columns'
            })
            continue
        
        # Calculate correlation
        data = df[[col1, col2]].dropna()
        if len(data) < 3:
            results.append({
                'feature1': col1,
                'feature2': col2,
                'correlation': np.nan,
                'expected_direction': expected_direction,
                'min_threshold': min_threshold,
                'status': 'insufficient_data'
            })
            continue
        
        corr = data[col1].corr(data[col2])
        
        # Check if correlation meets expectations
        status = 'valid'
        if expected_direction == 'positive' and corr < min_threshold:
            status = 'unexpectedly_low'
        elif expected_direction == 'negative' and corr > -min_threshold:
            status = 'unexpectedly_high'
        
        results.append({
            'feature1': col1,
            'feature2': col2,
            'correlation': corr,
            'expected_direction': expected_direction,
            'min_threshold': min_threshold,
            'status': status
        })
    
    return pd.DataFrame(results)

def chi_square_test_for_categorical(df, categorical_cols=None, alpha=0.05):
    """
    Perform chi-square test of independence for categorical variables.
    Returns a DataFrame with test results.
    """
    if categorical_cols is None:
        categorical_cols = df.select_dtypes(include=['object', 'category']).columns.tolist()
    
    results = []
    
    for i in range(len(categorical_cols)):
        for j in range(i+1, len(categorical_cols)):
            col1 = categorical_cols[i]
            col2 = categorical_cols[j]
            
            # Create contingency table
            contingency_table = pd.crosstab(df[col1], df[col2])
            
            # Check if table is suitable for chi-square test
            if contingency_table.shape[0] < 2 or contingency_table.shape[1] < 2:
                continue
                
            # Perform chi-square test
            try:
                chi2, p, dof, expected = chi2_contingency(contingency_table)
                
                # Check expected frequencies
                if (expected < 5).sum() / expected.size > 0.2:
                    status = 'invalid_expected_frequencies'
                else:
                    status = 'independent' if p > alpha else 'dependent'
                
                results.append({
                    'feature1': col1,
                    'feature2': col2,
                    'chi2_stat': chi2,
                    'p_value': p,
                    'degrees_of_freedom': dof,
                    'status': status
                })
            except Exception as e:
                results.append({
                    'feature1': col1,
                    'feature2': col2,
                    'error': str(e),
                    'status': 'test_failed'
                })
    
    return pd.DataFrame(results)






def anova_test_by_region(df, numeric_cols=None, group_col='WHO_region', alpha=0.05):
    """
    Perform ANOVA test to compare means across regions.
    Returns a DataFrame with test results.
    """
    if numeric_cols is None:
        numeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()
    
    results = []
    for col in numeric_cols:
        if col not in df.columns:
            continue
            
        # Prepare data for ANOVA
        groups = []
        group_names = []
        
        for group in df[group_col].unique():
            group_data = df[df[group_col] == group][col].dropna()
            if len(group_data) > 2:  # Need at least 3 data points per group
                groups.append(group_data)
                group_names.append(group)
        
        if len(groups) < 2:
            continue
            
        # Perform ANOVA
        try:
            stat, p = stats.f_oneway(*groups)
            
            # Post-hoc test if ANOVA is significant
            post_hoc = None
            if p < alpha:
                try:
                    # Prepare data for Tukey's test
                    all_data = []
                    all_groups = []
                    for i, group in enumerate(groups):
                        all_data.extend(group)
                        all_groups.extend([group_names[i]] * len(group))
                    
                    tukey_data = pd.DataFrame({'value': all_data, 'group': all_groups})
                    tukey = pairwise_tukeyhsd(tukey_data['value'], tukey_data['group'])
                    
                    # Convert results table to serializable format
                    if hasattr(tukey, '_results_table'):
                        # Extract table data and convert to list of dictionaries
                        headers = tukey._results_table.data[0]
                        rows = tukey._results_table.data[1:]
                        post_hoc = []
                        for row in rows:
                            post_hoc.append(dict(zip(headers, [str(cell) for cell in row])))
                    else:
                        post_hoc = "Post-hoc results not available"
                except Exception as e:
                    post_hoc = f"Error in post-hoc test: {str(e)}"
            
            results.append({
                'feature': col,
                'f_stat': stat,
                'p_value': p,
                'significant': p < alpha,
                'post_hoc_results': post_hoc
            })
        except Exception as e:
            results.append({
                'feature': col,
                'error': str(e),
                'status': 'test_failed'
            })
  
    return pd.DataFrame(results)
