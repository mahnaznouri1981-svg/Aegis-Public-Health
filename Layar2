def clean_data(df, missing_threshold, critical_columns, essential_columns):
    """
    Clean data by handling missing values and outliers.
    Now uses the modified parallel_hybrid_outlier_detection.
    """
    # Create a copy to avoid modifying original DataFrame
    df_cleaned = df.copy()
    
    # Missing data analysis
    missing_percent = {}
    for col in df_cleaned.columns:
        missing_percent[col] = calculate_missing_percent_optimized(df_cleaned, col)
    
    missing_data = {}
    missing_data["missing_percent"] = missing_percent
    log_step(
        "missing_data_analysis",
        missing_data,
        severity="medium",
        category="missing_data",
        message=f"Analyzing missing data patterns with threshold {missing_threshold:.2f}%",
        recommendation="Review columns with high missing percentages"
    )
    
    plt.figure(figsize=(10, 8))
    sns.heatmap(df_cleaned.isnull(), cbar=False, cmap='viridis', annot=False)
    plt.title('Missing Data Heatmap (Before Cleaning)', fontsize=10)
    plt.tight_layout()
    plt.savefig(os.path.join(output_plots_dir, "missing_data_heatmap_before.png"), dpi=300)
    plt.close()
    print(f"Dataframe dimensions: {df_cleaned.shape}")
    print(f"Number of missing values in each column:\n{df_cleaned.isnull().sum()}")
    print("Missing data heatmap saved.")
    
    # Determine columns to drop
    cols_to_drop = []
    protected_cols = []
    
    for col, percent in missing_percent.items():
        if col in essential_columns:
            protected_cols.append(col)
            if percent > missing_threshold:
                log_step(
                    "column_protection",
                    {
                        "column": col,
                        "missing_percent": percent,
                        "threshold": missing_threshold
                    },
                    severity="high",
                    category="missing_data",
                    message=f"Protected essential column '{col}' with {percent:.2f}% missing data",
                    recommendation="Consider imputation methods"
                )
            continue
        
        if col in critical_columns:
            if percent > 80:
                cols_to_drop.append(col)
        else:
            if percent > missing_threshold:
                cols_to_drop.append(col)
    
    log_step(
        "columns_to_drop",
        {
            "threshold": missing_threshold,
            "critical_columns": critical_columns,
            "essential_columns": essential_columns,
            "protected_columns": protected_cols,
            "columns": cols_to_drop
        },
        severity="medium",
        category="missing_data",
        message=f"Identified {len(cols_to_drop)} columns to drop, protected {len(protected_cols)} essential columns",
        recommendation="Review protected columns"
    )
    
    # Drop columns
    df_cleaned = df_cleaned.drop(columns=cols_to_drop)
    print(f"Dropped columns: {cols_to_drop}")
    
    # Drop rows with missing values in important columns
    important_cols = [col for col, percent in missing_percent.items() if 0 < percent < 5 and col not in critical_columns]
    if important_cols:
        df_cleaned = df_cleaned.dropna(subset=important_cols)
        log_step(
            "rows_dropped",
            {
                "important_columns": important_cols,
                "rows_before": len(df),
                "rows_after": len(df_cleaned)
            },
            severity="low",
            category="missing_data",
            message=f"Dropped {len(df) - len(df_cleaned)} rows with missing values",
            recommendation="Consider imputation"
        )
        print(f"Dropped rows in important columns: {len(df) - len(df_cleaned)}")
    
    # Fill vaccine columns
    vaccine_cols = [col for col in df_cleaned.columns if 'vaccin' in col.lower()]
    for col in vaccine_cols:
        if df_cleaned[col].isnull().any():
            df_cleaned[col] = df_cleaned[col].fillna(-1)
            print(f"Filled missing values in {col} with -1")
    
    # Outlier detection section - now uses top-level functions
    print("\nDetecting and handling outliers using hybrid methods...")
    numeric_cols = df_cleaned.select_dtypes(include=[np.number]).columns
    outliers_data = parallel_hybrid_outlier_detection(df_cleaned, numeric_cols)
    
    # Handle outliers in critical columns
    for col, outlier_info in outliers_data.items():
        if col in critical_columns:
            median_val = df_cleaned[col].median()
            
            # Get outlier indices from the new format
            outlier_indices = []
            for method_data in outlier_info['outliers'].values():
                outlier_indices.extend(method_data['indices'])
            
            outlier_indices = list(set(outlier_indices))  # Remove duplicates
            
            log_step(
                "outlier_imputation",
                {
                    "column": col,
                    "outlier_count": outlier_info['total_outliers'],
                    "outlier_percent": outlier_info['total_outliers'] / len(df_cleaned) * 100,
                    "imputation_method": "median"
                },
                severity="medium",
                category="outlier",
                message=f"Imputed {outlier_info['total_outliers']} outliers in critical column '{col}'",
                recommendation="Review imputed values"
            )
            
            df_cleaned.loc[outlier_indices, col] = median_val
    
    plt.figure(figsize=(10, 8))
    sns.heatmap(df_cleaned.isnull(), cbar=False, cmap='viridis', annot=False)
    plt.title('Missing Data Heatmap (After Cleaning)', fontsize=10)
    plt.tight_layout()
    plt.savefig(os.path.join(output_plots_dir, "missing_data_heatmap_after.png"), dpi=300)
    plt.close()
    print("Missing data heatmap after cleaning saved.")
    
    log_step(
        "data_cleaning_completed",
        {
            "original_shape": df.shape,
            "cleaned_shape": df_cleaned.shape,
            "columns_dropped": cols_to_drop,
            "protected_columns": protected_cols,
            "important_columns": important_cols,
            "vaccine_columns_filled": vaccine_cols,
            "outliers_handled": outliers_data,
            "threshold_used": missing_threshold
        },
        severity="medium",
        category="missing_data",
        message=f"Data cleaning completed. Original shape: {df.shape}, Cleaned shape: {df_cleaned.shape}",
        recommendation="Review cleaned data"
    )
    
    print("\nData cleaning completed!")
    print(f"Original data shape: {df.shape}")
    print(f"Cleaned data shape: {df_cleaned.shape}")
    print(f"Number of columns dropped: {len(cols_to_drop)}")
    print(f"Number of essential columns protected: {len(protected_cols)}")
    print(f"Number of rows dropped: {len(df) - len(df_cleaned)}")
    print(f"Number of vaccine columns filled: {len(vaccine_cols)}")
    print(f"Number of columns with outliers handled: {len(outliers_data)}")
    
    return df_cleaned, cols_to_drop, protected_cols, important_cols, vaccine_cols, outliers_data

