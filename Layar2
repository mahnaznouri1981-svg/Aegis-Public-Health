def hybrid_outlier_detection_original(df, col, methods=['iqr', 'zscore', 'isolation_forest', 'lof']):
    """Hybrid outlier detection using multiple methods"""
    all_outliers = []
    
    if 'iqr' in methods:
        outliers, _, _ = detect_outliers_iqr_optimized(df, col)
        if not outliers.empty:
            outliers['method'] = 'iqr'
            all_outliers.append(outliers)
    
    if 'zscore' in methods:
        outliers, _, _ = detect_outliers_zscore(df, col)
        if not outliers.empty:
            outliers['method'] = 'zscore'
            all_outliers.append(outliers)
    
    if 'isolation_forest' in methods:
        outliers, _, _ = detect_outliers_isolation_forest(df, col)
        if not outliers.empty:
            outliers['method'] = 'isolation_forest'
            all_outliers.append(outliers)
    
    if 'lof' in methods:
        outliers, _, _ = detect_outliers_lof(df, col)
        if not outliers.empty:
            outliers['method'] = 'lof'
            all_outliers.append(outliers)
    
    if not all_outliers:
        return pd.DataFrame()
    
    # Combine results and identify points detected by at least 2 methods
    combined_outliers = pd.concat(all_outliers)
    outlier_counts = combined_outliers.index.value_counts()
    reliable_outliers = outlier_counts[outlier_counts >= 2].index   
    return df.loc[reliable_outliers]

