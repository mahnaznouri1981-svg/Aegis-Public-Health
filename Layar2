def parallel_hybrid_outlier_detection(df, columns, methods=['iqr', 'zscore', 'modified_zscore', 'isolation_forest']):
    """
    Detect outliers in multiple columns using parallel processing.
    Now uses top-level functions for multiprocessing compatibility.
    """
    # Prepare arguments for each column
    args = [(col, df, methods) for col in columns]
    
    # Use parallel processing if available
    if PARALLEL_AVAILABLE and NUM_CORES > 1:
        try:
            with Pool(processes=NUM_CORES) as pool:
                results = pool.map(hybrid_outlier_detection_wrapper, args)
        except Exception as e:
            print(f"Parallel processing failed: {e}. Falling back to sequential processing.")
            results = [hybrid_outlier_detection_wrapper(arg) for arg in args]
    else:
        results = [hybrid_outlier_detection_wrapper(arg) for arg in args]
    
    # Convert results to a dictionary keyed by column name
    outliers_dict = {}
    for result in results:
        outliers_dict[result['column']] = result
    
    return outliers_dict

