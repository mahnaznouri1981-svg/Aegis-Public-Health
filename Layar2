def hybrid_outlier_detection(column, df, methods):
    """
    Detect outliers in a specific column using hybrid methods.
    This function was moved to top level to be accessible in multiprocessing.
    """
    data = df[column]
    outliers = {}
    
    # Apply each specified outlier detection method
    for method in methods:
        if method == 'iqr':
            Q1 = data.quantile(0.25)
            Q3 = data.quantile(0.75)
            IQR = Q3 - Q1
            lower_bound = Q1 - 1.5 * IQR
            upper_bound = Q3 + 1.5 * IQR
            outlier_mask = (data < lower_bound) | (data > upper_bound)
            
        elif method == 'zscore':
            z_scores = np.abs((data - data.mean()) / data.std())
            outlier_mask = z_scores > 3
            
        elif method == 'modified_zscore':
            median = np.median(data)
            mad = np.median(np.abs(data - median))
            modified_z_scores = 0.6745 * (data - median) / mad
            outlier_mask = np.abs(modified_z_scores) > 3.5
            
        elif method == 'isolation_forest':
            clf = IsolationForest(contamination=0.1, random_state=42)
            outlier_mask = clf.fit_predict(data.values.reshape(-1, 1)) == -1
            
        outliers[method] = {
            'count': outlier_mask.sum(),
            'indices': data.index[outlier_mask].tolist(),
            'values': data[outlier_mask].tolist()
        }
    
    return {
        'column': column,
        'outliers': outliers,
        'total_outliers': sum(v['count'] for v in outliers.values())
    }

def hybrid_outlier_detection_wrapper(args):
    """
    Wrapper function to unpack arguments for multiprocessing.
    This function was moved to top level to be accessible in multiprocessing.
    """
    col, df, methods = args
    return hybrid_outlier_detection(col, df, methods)

