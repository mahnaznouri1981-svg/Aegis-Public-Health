def generate_forecast_plots(fitted_models, df, output_dir):
    print("\nGenerating model fit plots...")
    plot_info_list = []
    for region, models_data in fitted_models.items():
        if not models_data: continue
        region_data = df[df["WHO_region"] == region].copy()
        vacc_start_date = region_data['vaccination_start_date'].min()
        
        # Use data from vaccination start date
        if pd.notna(vacc_start_date):
            region_data = region_data[region_data['date'] >= vacc_start_date]
        
        region_data.set_index("date", inplace=True)
        y = region_data["Death_rate_100k"]
        
        for model_key, model in models_data.items():
            try:
                if model_key.startswith("SARIMAX_"):
                    # Extract lag from model key
                    lag = model_key.split("_")[1]
                    
                    fitted_values = model.fittedvalues
                    residuals = model.resid
                    fig = plt.figure(figsize=(16, 10))
                    gs = GridSpec(2, 2, figure=fig, hspace=0.3, wspace=0.3)
                    
                    ax1 = fig.add_subplot(gs[0, :])
                    ax1.plot(y.index, y, label='Historical Data', color='royalblue', linewidth=2)
                    ax1.plot(fitted_values.index, fitted_values, label='Model Fit (Fitted Values)', color='tomato', linestyle='--', linewidth=2)
                    ax1.set_title(f'SARIMAX Model Fit for {region} (Lag: {lag} days)', fontsize=16, fontweight='bold')
                    ax1.set_xlabel('Date'); ax1.set_ylabel('Death Rate per 100k'); ax1.legend(); ax1.grid(True, linestyle='--', alpha=0.6)
                    
                    # Add vaccination start date line
                    if pd.notna(vacc_start_date):
                        ax1.axvline(x=vacc_start_date, color='green', linestyle=':', linewidth=2, label='Vaccination Start')
                    
                    stats_text = f'AIC: {model.aic:.2f}\nRMSE: {np.sqrt(np.mean(resid**2)):.4f}'
                    ax1.text(0.05, 0.95, stats_text, transform=ax1.transAxes, fontsize=10, verticalalignment='top', bbox=dict(boxstyle='round,pad=0.5', fc='wheat', alpha=0.5))
                    
                    ax2 = fig.add_subplot(gs[1, 0]); ax2.plot(residuals.index, residuals, color='gray'); ax2.axhline(0, color='black', linestyle='--')
                    ax2.set_title('Residuals Over Time'); ax2.set_xlabel('Date'); ax2.set_ylabel('Residuals'); ax2.grid(True, linestyle='--', alpha=0.6)
                    
                    ax3 = fig.add_subplot(gs[1, 1]); ax3.hist(residuals, bins=20, color='skyblue', edgecolor='black')
                    ax3.set_title('Distribution of Residuals'); ax3.set_xlabel('Residual Value'); ax3.set_ylabel('Frequency'); ax3.grid(True, linestyle='--', alpha=0.6)
                    
                    plot_path = output_dir / f"sarimax_model_fit_{region}_lag{lag}.png"
                    plt.savefig(plot_path, dpi=300, bbox_inches='tight')
                    plt.close(fig)
                    
                    caption = (f"Detailed SARIMAX model diagnostics for {region} using a {lag}-day lag. The analysis focuses on the period from vaccination start date. "
                               f"The main plot compares the actual death rate with the model's fitted values, showing how well the model captures the observed trend. "
                               f"The green dotted line indicates the vaccination start date. The lower-left plot displays the residuals over time, "
                               f"and the lower-right plot shows the distribution of residuals.")
                    plot_info_list.append({"path": plot_path, "caption": caption})
                
                elif model_key == "VAR":
                    # Plot VAR impulse response functions
                    irf = model.irf(10)
                    fig = irf.plot(orth=False, impulse='fully_vaccinated_100k', response='Death_rate_100k')
                    fig.suptitle(f'VAR Impulse Response for {region}', fontsize=16, fontweight='bold')
                    fig.set_size_inches(12, 8)
                    
                    plot_path = output_dir / f"var_impulse_response_{region}.png"
                    plt.savefig(plot_path, dpi=300, bbox_inches='tight')
                    plt.close(fig)
                    
                    caption = (f"VAR impulse response function for {region}, showing the effect of a shock to the vaccination rate on the death rate over time. "
                               f"This visualization helps understand the dynamic relationship between vaccination and mortality in the VAR framework.")
                    plot_info_list.append({"path": plot_path, "caption": caption})
                
                elif model_key == "VECM":
                    # Plot VECM cointegration relations
                    fig = plt.figure(figsize=(12, 8))
                    plt.plot(model.cointegrating_vectors[0])
                    plt.title(f'VECM Cointegration Relations for {region}', fontsize=16, fontweight='bold')
                    plt.xlabel('Time'); plt.ylabel('Cointegration Relation')
                    plt.grid(True, linestyle='--', alpha=0.6)
                    
                    plot_path = output_dir / f"vecm_cointegration_{region}.png"
                    plt.savefig(plot_path, dpi=300, bbox_inches='tight')
                    plt.close(fig)
                    
                    caption = (f"VECM cointegration relations for {region}, showing the long-term equilibrium relationship between death rate and vaccination variables. "
                               f"The cointegration relation should be stationary if the model is correctly specified.")
                    plot_info_list.append({"path": plot_path, "caption": caption})
            except Exception as e:
                print(f"Could not generate model fit plot for {region}, model {model_key}: {e}")
    return plot_info_list

def generate_causality_plots(causality_df, output_path):
    fig, ax = plt.subplots(figsize=(15, 8))
    
    # Filter for significant causal relationships
    significant_causality = causality_df[causality_df['Is_Causal'] == True]
    
    # Create a pivot table for heatmap
    pivot = significant_causality.pivot_table(
        index='Region', 
        columns='Cause', 
        values='Min_P_Value', 
        aggfunc='min'
    )
    
    # Create heatmap
    sns.heatmap(pivot, annot=True, fmt=".3f", cmap='RdYlGn_r', ax=ax, cbar_kws={'label': 'Min P-Value'})
    ax.set_title('Granger Causality Results (Significant Relationships Only)', fontsize=16, fontweight='bold')
    plt.tight_layout()
    plt.savefig(output_path, dpi=300)
    plt.close()
    print(f"Causality plot saved to {output_path}")

def generate_cross_correlation_plots(cross_corr_df, output_path):
    fig, ax = plt.subplots(figsize=(15, 8))
    
    # Plot for each vaccination variable
    for var in cross_corr_df['Variable'].unique():
        var_data = cross_corr_df[cross_corr_df['Variable'] == var]
        sns.lineplot(data=var_data, x='Region', y='Optimal_Lag', marker='o', label=f'{var} Optimal Lag', ax=ax)
    
    ax.set_title('Optimal Lag from Cross-Correlation Analysis by Region', fontsize=16, fontweight='bold')
    ax.set_ylabel('Optimal Lag (days)')
    ax.legend()
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.savefig(output_path, dpi=300)
    plt.close()
    print(f"Cross-correlation plot saved to {output_path}")

def generate_model_comparison_plot(results_df, output_path):
    fig, axes = plt.subplots(2, 2, figsize=(20, 15))
    
    # Model Type Distribution
    model_counts = results_df['Model_Type'].value_counts()
    axes[0, 0].pie(model_counts.values, labels=model_counts.index, autopct='%1.1f%%', startangle=90)
    axes[0, 0].set_title('Distribution of Model Types', fontsize=14, fontweight='bold')
    
    # AIC by Model Type
    sns.boxplot(data=results_df, x='Model_Type', y='AIC', ax=axes[0, 1])
    axes[0, 1].set_title('AIC by Model Type', fontsize=14, fontweight='bold')
    
    # Effect Size by Model Type
    sarimax_data = results_df[results_df['Model_Type'] == 'SARIMAX'].dropna(subset=['Effect'])
    if not sarimax_data.empty:
        sns.boxplot(data=sarimax_data, x='Region', y='Effect', ax=axes[1, 0])
        axes[1, 0].set_title('Vaccine Effect Size by Region (SARIMAX)', fontsize=14, fontweight='bold')
        axes[1, 0].tick_params(axis='x', rotation=45)
    
    # Success Rate by Model Type
    success_rate = execution_df.groupby('Model_Type')['Status'].apply(lambda x: (x == 'Success').mean())
    success_rate.plot(kind='bar', ax=axes[1, 1])
    axes[1, 1].set_title('Model Success Rate by Type', fontsize=14, fontweight='bold')
    axes[1, 1].set_ylabel('Success Rate')
    axes[1, 1].tick_params(axis='x', rotation=45)
    
    plt.tight_layout()
    plt.savefig(output_path, dpi=300)
    plt.close()
    print(f"Model comparison plot saved to {output_path}")

def generate_lag_selection_plot(results_df, output_path):
    fig, ax = plt.subplots(figsize=(12, 7))
    
    # Filter for SARIMAX models only
    sarimax_data = results_df[results_df['Model_Type'] == 'SARIMAX'].dropna(subset=['Lag'])
    
    if not sarimax_data.empty:
        sns.boxplot(data=sarimax_data, x='Lag_Selection_Method', y='AIC', ax=ax)
        ax.set_title('Model Performance by Lag Selection Method', fontsize=16, fontweight='bold')
        ax.set_ylabel('AIC')
        plt.tight_layout()
        plt.savefig(output_path, dpi=300)
        plt.close()
        print(f"Lag selection plot saved to {output_path}")
    else:
        print("No SARIMAX models with lag data available for lag selection plot.")

def generate_model_execution_plot(execution_details_df, output_path):
    fig, ax = plt.subplots(figsize=(12, 7))
    execution_counts = execution_details_df.groupby(['Region', 'Model_Type', 'Status']).size().unstack(fill_value=0)
    execution_counts.plot(kind='bar', stacked=True, ax=ax, color=['#d62728', '#2ca02c'])
    ax.set_title('Model Execution Status by Region and Type', fontsize=16, fontweight='bold')
    ax.set_ylabel('Number of Models')
    ax.set_xlabel('Region / Model Type')
    ax.legend(title='Status')
    ax.grid(True, linestyle='--', alpha=0.6)
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.savefig(output_path, dpi=300)
    plt.close()
    print(f"Model execution plot saved to {output_path}")

def generate_vaccination_timeline_plot(df, output_path):
    """Generate a plot showing vaccination timeline across regions."""
    fig, ax = plt.subplots(figsize=(15, 8))
    
    # Get vaccination start dates by region
    vacc_start_dates = df.groupby('WHO_region')['vaccination_start_date'].min().sort_values()
    
    # Create a timeline
    for i, (region, start_date) in enumerate(vacc_start_dates.items()):
        if pd.notna(start_date):
            ax.barh(i, 1, left=start_date, height=0.8, alpha=0.7)
            ax.text(start_date, i, f'  {region} ({start_date.strftime("%Y-%m-%d")})', 
                   va='center', fontsize=10)
    
    ax.set_yticks([])
    ax.set_xlabel('Date')
    ax.set_title('Vaccination Start Timeline by WHO Region', fontsize=16, fontweight='bold')
    ax.grid(True, linestyle='--', alpha=0.6)
    plt.tight_layout()
    plt.savefig(output_path, dpi=300)
    plt.close()
    print(f"Vaccination timeline plot saved to {output_path}")

def generate_text_reports(results_df, execution_details_df, causality_df, analytical_report_dir, governance_report_dir):
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    comp_report_path = analytical_report_dir / "comprehensive_report.txt"
    
    # Calculate summary statistics
    total_models = len(execution_details_df)
    successful_models = len(execution_details_df[execution_details_df['Status'] == 'Success'])
    model_types = results_df['Model_Type'].value_counts().to_dict()
    causality_count = len(causality_df[causality_df['Is_Causal'] == True])
    
    # Calculate average analysis period
    avg_analysis_period = results_df['Analysis_Period_Days'].mean()
    
    with open(comp_report_path, "w", encoding="utf-8") as f:
        f.write("===========================================================\n")
        f.write("    Enhanced COVID-19 Modeling Analysis Report (Layer 4)\n")
        f.write("===========================================================\n\n")
        f.write(f"Generated on: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n")
        f.write("--- VACCINATION TIMELINE ANALYSIS ---\n")
        f.write(f"This analysis correctly handles the vaccination timeline, recognizing that vaccination data\n")
        f.write(f"is only available from the date vaccines were first administered in each region.\n")
        f.write(f"Average analysis period per region: {avg_analysis_period:.1f} days\n\n")
        
        f.write("--- EXECUTION SUMMARY ---\n")
        f.write(f"Total Models Attempted: {total_models}\n")
        f.write(f"Successful Models: {successful_models}\n")
        f.write(f"Success Rate: {successful_models/total_models*100:.1f}%\n\n")
        
        f.write("--- MODEL TYPE BREAKDOWN ---\n")
        for model_type, count in model_types.items():
            f.write(f"{model_type}: {count} models\n")
        f.write("\n")
        
        f.write("--- CAUSALITY ANALYSIS ---\n")
        f.write(f"Significant causal relationships found: {causality_count}\n")
        f.write(f"Total causality tests performed: {len(causality_df)}\n\n")
        
        f.write("--- MODEL PERFORMANCE METRICS ---\n")
        sarimax_data = results_df[results_df['Model_Type'] == 'SARIMAX'].dropna(subset=['AIC', 'RMSE', 'Effect'])
        if not sarimax_data.empty:
            f.write(f"Average AIC (SARIMAX): {sarimax_data['AIC'].mean():.2f} (±{sarimax_data['AIC'].std():.2f})\n")
            f.write(f"Average RMSE (SARIMAX): {sarimax_data['RMSE'].mean():.4f} (±{sarimax_data['RMSE'].std():.4f})\n")
            f.write(f"Average Effect Size (SARIMAX): {sarimax_data['Effect'].mean():.4f} (±{sarimax_data['Effect'].std():.4f})\n")
            f.write(f"Significant Models (p<0.05): {len(sarimax_data[sarimax_data['p_value'] < 0.05])} ({len(sarimax_data[sarimax_data['p_value'] < 0.05])/len(sarimax_data)*100:.1f}%)\n\n")
        
        var_data = results_df[results_df['Model_Type'] == 'VAR']
        if not var_data.empty:
            f.write(f"Average AIC (VAR): {var_data['AIC'].mean():.2f} (±{var_data['AIC'].std():.2f})\n\n")
        
        vecm_data = results_df[results_df['Model_Type'] == 'VECM']
        if not vecm_data.empty:
            f.write(f"Average AIC (VECM): {vecm_data['AIC'].mean():.2f} (±{vecm_data['AIC'].std():.2f})\n\n")
        
        f.write("--- DETAILED RESULTS ---\n")
        f.write(results_df.to_string())
    
    print(f"Comprehensive report saved to {comp_report_path}")
    
    mon_report_path = governance_report_dir / f"monitoring_report_{timestamp}.txt"
    with open(mon_report_path, "w", encoding="utf-8") as f:
        f.write(f"Monitoring Log for Layer 4 Execution\nTimestamp: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
        f.write("="*40 + "\n\n")
        f.write(execution_details_df.to_string())
    
    print(f"Monitoring report saved to {mon_report_path}")
    return comp_report_path, mon_report_path

