# Check for missing values in non-vaccination columns only
non_vacc_cols = [col for col in df.select_dtypes(include=[np.number]).columns 
                 if not any(vacc_term in col.lower() for vacc_term in ['vaccinated', 'vaccine', 'dose'])]

for col in non_vacc_cols:
    missing_pct = df[col].isnull().sum() / len(df) * 100
    validation_results["missing_values"][col] = missing_pct < 5  # Pass if less than 5% missing
    
    if missing_pct >= 5:
        governance.log_audit(
            variable=col,
            issue=f"High percentage of missing values ({missing_pct:.2f}%)",
            action="Imputation with median value"
        )
        df[col].fillna(df[col].median(), inplace=True)
        
        governance.log_anomaly(
            variable=col,
            anomaly_type="Missing Values",
            value=missing_pct,
            threshold=5.0,
            explanation=f"The column {col} has a high percentage of missing values, which may bias the analysis.",
            suggested_action="Consider data collection improvements or alternative imputation methods."
        )

# Check vaccination data availability by region
for region in df["WHO_region"].unique():
    region_data = df[df["WHO_region"] == region].copy()
    vacc_start_date = region_data['vaccination_start_date'].min()
    
    # Count days with vaccination data
    vacc_cols = ['fully_vaccinated_100k', 'persons_vaccinated_100k', 'vaccine_doses_administered_100k']
    vacc_data_available = 0
    total_days_after_vacc = 0
    
    if pd.notna(vacc_start_date):
        vacc_period = region_data[region_data['date'] >= vacc_start_date]
        total_days_after_vacc = len(vacc_period)
        
        for col in vacc_cols:
            if col in vacc_period.columns:
                vacc_data_count = vacc_period[col].notna().sum()
                vacc_data_available = max(vacc_data_available, vacc_data_count)
        
        vacc_coverage = (vacc_data_available / total_days_after_vacc * 100) if total_days_after_vacc > 0 else 0
        validation_results["vaccination_timeline"][f"{region}_coverage"] = vacc_coverage > 80  # Pass if >80% coverage
        
        if vacc_coverage < 80:
            governance.log_audit(
                variable=f"{region}_vaccination_data",
                issue=f"Low vaccination data coverage ({vacc_coverage:.1f}%) after vaccination start date",
                action="Analysis will focus on available vaccination period"
            )
    
    # Check for outliers in all numeric columns
    for col in df.select_dtypes(include=[np.number]).columns:
        # Only check outliers in the relevant time period for vaccination data
        if col in vacc_cols and pd.notna(vacc_start_date):
            check_data = region_data[region_data['date'] >= vacc_start_date][col]
        else:
            check_data = region_data[col]
        
        if len(check_data) > 0:
            z_scores = np.abs(stats.zscore(check_data.dropna()))
            outliers_pct = (z_scores > 3).sum() / len(z_scores) * 100
            validation_results["outliers"][f"{region}_{col}"] = outliers_pct < 5  # Pass if less than 5% outliers
            
            if outliers_pct >= 5:
                governance.log_audit(
                    variable=f"{region}_{col}",
                    issue=f"High percentage of outliers ({outliers_pct:.2f}%)",
                    action="Winsorization at 1st and 99th percentiles"
                )
                
                # Winsorize the data
                lower_bound = check_data.quantile(0.01)
                upper_bound = check_data.quantile(0.99)
                df.loc[region_data.index, col] = df.loc[region_data.index, col].clip(lower=lower_bound, upper=upper_bound)
                
                governance.log_anomaly(
                    variable=f"{region}_{col}",
                    anomaly_type="Outliers",
                    value=outliers_pct,
                    threshold=5.0,
                    explanation=f"The column {col} in {region} contains a high percentage of outliers, which may affect model performance.",
                    suggested_action="Consider robust modeling techniques or further investigation of extreme values."
                )

