        self.logger = logging.getLogger("GovernanceLayer")

    def log_event(self, category: str, description: str, details: dict = None, severity: str = "INFO"):
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        # Convert all details to serializable format before creating the event
        serializable_details = convert_to_serializable(details) if details else {}
        
        event = {
            "timestamp": timestamp, "run_id": self.run_id, "category": category,
            "description": description, "details": serializable_details, "severity": severity
        }
        with open(self.audit_dir / f"decisions_{self.run_id}.jsonl", 'a', encoding='utf-8') as f:
            f.write(json.dumps(convert_to_serializable(event), ensure_ascii=False) + '\n')
        log_method = getattr(self.logger, severity.lower(), self.logger.info)
        log_method(f"[{category}] {description}")

    def log_decision(self, decision_type: str, description: str, rationale: str, parameters: dict = None, outcome: str = None):
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        # Convert parameters to serializable format
        serializable_params = convert_to_serializable(parameters) if parameters else {}
        
        decision = {
            "timestamp": timestamp, "run_id": self.run_id, "type": decision_type,
            "description": description, "rationale": rationale,
            "parameters": serializable_params, "outcome": outcome
        }
        self.decisions_log.append(decision)
        self.log_event("DECISION", description, {"rationale": rationale, "parameters": serializable_params}, "INFO")

