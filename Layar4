def select_optimal_lag(y, max_lag=60, criterion='aic'):
    """
    Select optimal lag based on AIC, BIC, or HQIC.
    
    Parameters:
    - y: time series data
    - max_lag: maximum lag to consider
    - criterion: 'aic', 'bic', or 'hqic'
    
    Returns:
    - optimal lag value
    """
    try:
        # Use AutoReg instead of deprecated AR
        from statsmodels.tsa.ar_model import AutoReg
        
        aic_values = []
        bic_values = []
        hqic_values = []
        
        for lag in range(1, max_lag + 1):
            model = AutoReg(y, lags=lag).fit()
            aic_values.append(model.aic)
            bic_values.append(model.bic)
            hqic_values.append(model.hqic)
        
        if criterion == 'aic':
            optimal_lag = np.argmin(aic_values) + 1
        elif criterion == 'bic':
            optimal_lag = np.argmin(bic_values) + 1
        elif criterion == 'hqic':
            optimal_lag = np.argmin(hqic_values) + 1
        else:
            optimal_lag = np.argmin(aic_values) + 1
        
        return optimal_lag
    except Exception as e:
        print(f"Error in lag selection: {e}")
        return 14  # Default to 14 days if error occurs

def check_stationarity(series, signif=0.05):
    """
    Check if a time series is stationary using ADF test.
    
    Parameters:
    - series: time series data
    - signif: significance level
    
    Returns:
    - is_stationary: boolean
    - p_value: float
    """
    result = adfuller(series)
    p_value = result[1]
    is_stationary = p_value < signif
    return is_stationary, p_value

def check_cointegration(y, x, maxlag=5, signif=0.05):
    """
    Check if two time series are cointegrated using Johansen test.
    
    Parameters:
    - y, x: time series data
    - maxlag: maximum lag for the test
    - signif: significance level
    
    Returns:
    - is_cointegrated: boolean
    - test_statistic: float
    - critical_values: array
    """
    try:
        # Combine series into a DataFrame
        data = pd.concat([y, x], axis=1).dropna()
        
        # Perform Johansen test
        result = coint_johansen(data, det_order=0, k_ar_diff=maxlag)
        
        # Get test statistic and critical values
        test_statistic = result.lr1[0]  # First eigenvalue statistic
        critical_values = result.cvt[:, 0]  # 90%, 95%, 99% critical values
        
        # Check if test statistic exceeds 95% critical value
        is_cointegrated = test_statistic > critical_values[1]
        
        return is_cointegrated, test_statistic, critical_values
    except Exception as e:
        print(f"Error in cointegration test: {e}")
        return False, 0, [0, 0, 0]

def fit_sarimax_model(y, exog, order, seasonal_order=(0, 0, 0, 0), 
                     enforce_stationarity=False, enforce_invertibility=False):
    """
    Fit a SARIMAX model with the given parameters.
    
    Parameters:
    - y: endogenous variable
    - exog: exogenous variables
    - order: (p, d, q) order of the model
    - seasonal_order: (P, D, Q, s) seasonal order
    - enforce_stationarity: whether to enforce stationarity
    - enforce_invertibility: whether to enforce invertibility
    
    Returns:
    - fitted model
    """
    try:
        model = SARIMAX(
            y, 
            exog=exog,
            order=order,
            seasonal_order=seasonal_order,
            enforce_stationarity=enforce_stationarity,
            enforce_invertibility=enforce_invertibility
        )
        fitted_model = model.fit(disp=False)
        return fitted_model
    except Exception as e:
        print(f"Error fitting SARIMAX model: {e}")
        return None

def fit_var_model(data, maxlags=15, ic='aic'):
    """
    Fit a VAR model with automatic lag selection.
    
    Parameters:
    - data: DataFrame with time series data
    - maxlags: maximum number of lags to consider
    - ic: information criterion for lag selection ('aic', 'bic', 'hqic', 'fpe')
    
    Returns:
    - fitted model
    - selected lag
    """
    try:
        model = sm.tsa.VAR(data)
        lag_selection = model.select_order(maxlags=maxlags)
        selected_lag = lag_selection.aic if ic == 'aic' else lag_selection.bic if ic == 'bic' else lag_selection.hqic
        fitted_model = model.fit(selected_lag)
        return fitted_model, selected_lag
    except Exception as e:
        print(f"Error fitting VAR model: {e}")
        return None, None

def fit_vecm_model(data, deterministic='ci', k_ar_diff=None):
    """
    Fit a VECM model for cointegrated time series.
    
    Parameters:
    - data: DataFrame with cointegrated time series
    - deterministic: deterministic terms ('nc', 'ci', 'li', 'lo')
    - k_ar_diff: number of lags in the VECM
    
    Returns:
    - fitted model
    """
    try:
        # Ensure k_ar_diff is not None
        if k_ar_diff is None:
            k_ar_diff = 1  # Default to 1 lag if not specified
        
        model = VECM(data, deterministic=deterministic, k_ar_diff=k_ar_diff)
        fitted_model = model.fit()
        return fitted_model
    except Exception as e:
        print(f"Error fitting VECM model: {e}")
        return None

def granger_causality_test(y, x, maxlag=5, signif=0.05):
    """
    Perform Granger causality test to determine if x causes y.
    
    Parameters:
    - y: effect time series
    - x: cause time series
    - maxlag: maximum lag to consider
    - signif: significance level
    
    Returns:
    - is_causal: boolean
    - min_p_value: minimum p-value across all lags
    """
    try:
        data = pd.concat([y, x], axis=1).dropna()
        test_result = grangercausalitytests(data, maxlag=maxlag, verbose=False)
        
        # Extract p-values
        p_values = [test_result[i+1][0]['ssr_ftest'][1] for i in range(maxlag)]
        min_p_value = min(p_values)
        is_causal = min_p_value < signif
        
        return is_causal, min_p_value
    except Exception as e:
        print(f"Error in Granger causality test: {e}")
        return False, 1.0

def cross_correlation_analysis(y, x, max_lag=60):
    """
    Analyze cross-correlation between two time series.
    
    Parameters:
    - y, x: time series data
    - max_lag: maximum lag to consider
    
    Returns:
    - ccf_values: array of cross-correlation values
    - optimal_lag: lag with maximum absolute correlation
    """
    try:
        # Standardize the series
        scaler = StandardScaler()
        y_std = scaler.fit_transform(y.values.reshape(-1, 1)).flatten()
        x_std = scaler.fit_transform(x.values.reshape(-1, 1)).flatten()
        
        # Calculate cross-correlation
        ccf_values = ccf(y_std, x_std, adjusted=False)[:max_lag+1]
        
        # Find lag with maximum absolute correlation
        optimal_lag = np.argmax(np.abs(ccf_values))
        
        return ccf_values, optimal_lag
    except Exception as e:
        print(f"Error in cross-correlation analysis: {e}")
        return np.zeros(max_lag+1), 0

