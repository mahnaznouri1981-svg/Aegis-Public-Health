# EXECUTION WITH ENHANCED MODELING - CONSIDERING VACCINATION TIMELINE
# ------------------------------------------------------------
results = []
sensitivity = []
fitted_models = {}
model_execution_details = []
causality_results = []
cross_corr_results = []

governance.log_event("MODELING", "Starting enhanced model fitting loop with VAR/VECM.")

for dec in decisions:
    region = dec.get("region")
    if not region:
        governance.log_event("MODELING", "Skipping decision entry due to missing 'region' key.", severity="WARNING")
        continue
    
    d_order = dec.get("differencing_order", 0)
    exogs = ["fully_vaccinated_100k", "persons_vaccinated_100k", "vaccine_doses_administered_100k"]
    
    governance.log_event("MODELING", f"Processing region: {region}", {"d_order": d_order, "exogs": exogs})
    
    dfr = df[df["WHO_region"] == region].copy()
    dfr.set_index("date", inplace=True)
    
    if dfr.empty:
        governance.log_event("MODELING", f"No data found for region {region} in the CSV. Skipping.", {"region": region}, severity="WARNING")
        continue
    
    # Get vaccination start date for this region
    vacc_start_date = dfr['vaccination_start_date'].min()
    
    # Filter data to start from vaccination date for vaccination-related analysis
    if pd.notna(vacc_start_date):
        analysis_data = dfr[dfr.index >= vacc_start_date].copy()
        governance.log_event("MODELING", f"Analyzing {region} from vaccination start date: {vacc_start_date}", 
                            {"data_points": len(analysis_data)})
    else:
        analysis_data = dfr.copy()
        governance.log_event("MODELING", f"No vaccination start date found for {region}, using all data", 
                            {"data_points": len(analysis_data)})
    
    if len(analysis_data) < 30:
        reason = f"Insufficient data points after vaccination start ({len(analysis_data)} < 30)"
        governance.log_event("MODELING", f"Skipping region {region}", {"region": region, "reason": reason})
        continue
    
    y = analysis_data["Death_rate_100k"]
    fitted_models[region] = {}
    
    # Enhanced lag selection
    optimal_lag = select_optimal_lag(y, max_lag=60, criterion='aic')
    governance.log_event("MODELING", f"Optimal lag selected for {region}: {optimal_lag} days", 
                        {"method": "AIC minimization"})
    
    # Cross-correlation analysis
    for exog in exogs:
        if exog in analysis_data.columns:
            ccf_values, optimal_lag_ccf = cross_correlation_analysis(y, analysis_data[exog], max_lag=60)
            cross_corr_results.append({
                "Region": region,
                "Variable": exog,
                "Optimal_Lag": optimal_lag_ccf,
                "Max_Correlation": np.max(np.abs(ccf_values))
            })
    
    # Granger causality tests
    for exog in exogs:
        if exog in analysis_data.columns:
            is_causal, p_value = granger_causality_test(y, analysis_data[exog], maxlag=5)
            causality_results.append({
                "Region": region,
                "Cause": exog,
                "Effect": "Death_rate_100k",
                "Is_Causal": is_causal,
                "Min_P_Value": p_value
            })
    
    # Check for cointegration with vaccination variables
    cointegration_results = {}
    for exog in exogs:
        if exog in analysis_data.columns:
            is_cointegrated, test_stat, crit_values = check_cointegration(y, analysis_data[exog])
            cointegration_results[exog] = {
                "is_cointegrated": is_cointegrated,
                "test_statistic": test_stat,
                "critical_values": crit_values
            }
    
    # Fit SARIMAX models with different lags
    lags = [optimal_lag, 14, 28, 42]  # Include optimal lag and standard lags
    
    for lag in lags:
        X = pd.DataFrame(index=analysis_data.index)
        for v in exogs:
            X[f"{v}_lag{lag}"] = analysis_data[v].shift(lag)
        
        data = pd.concat([y, X], axis=1).dropna()
        if len(data) < 30:
            reason = f"Insufficient data points after lagging ({len(data)} < 30)"
            governance.log_event("MODELING", f"Skipping lag {lag} for {region}", 
                                {"region": region, "lag": lag, "reason": reason})
            governance.log_decision("MODEL_SKIPPED", f"Model for {region} lag {lag} was skipped", 
                                   reason, {"lag": lag, "data_points": len(data)})
            model_execution_details.append({
                "Region": region, 
                "Lag": lag, 
                "Model_Type": "SARIMAX",
                "Status": "Failed", 
                "Reason": reason
            })
            continue
        
        try:
            # Fit SARIMAX model with deterministic terms
            model = SARIMAX(
                data["Death_rate_100k"], 
                exog=data[X.columns], 
                order=(1, d_order, 1), 
                seasonal_order=(0, 0, 0, 0),
                enforce_stationarity=False,
                enforce_invertibility=False,
                trend='c'  # Include constant term
            ).fit(disp=False)
            
            resid = model.resid
            lb_p = acorr_ljungbox(resid, lags=[10], return_df=True)["lb_pvalue"].iloc[0]
            effect_params = model.params.filter(like="fully_vaccinated_100k")
            effect = effect_params.mean() if not effect_params.empty else np.nan
            pval_params = model.pvalues.filter(like="fully_vaccinated_100k")
            pval = pval_params.mean() if not pval_params.empty else np.nan
            
            results.append({
                "Region": region, 
                "Lag": lag, 
                "D_Order": d_order, 
                "Model_Type": "SARIMAX",
                "Effect": effect, 
                "p_value": pval, 
                "AIC": model.aic, 
                "RMSE": np.sqrt(np.mean(resid**2)), 
                "Residuals_white": lb_p > 0.05,
                "Lag_Selection_Method": "AIC" if lag == optimal_lag else "Fixed",
                "Vaccination_Start_Date": str(vacc_start_date) if pd.notna(vacc_start_date) else None,
                "Analysis_Period_Days": len(analysis_data)
            })
            
            sensitivity.append({
                "Region": region, 
                "Lag": lag, 
                "Effect": effect,
                "Model_Type": "SARIMAX"
            })
            
            fitted_models[region][f"SARIMAX_{lag}"] = model
            
            outcome_text = f"Effect: {effect:.4f}, AIC: {model.aic:.2f}"
            governance.log_decision("MODEL_FIT_SUCCESS", f"SARIMAX model fitted for {region} lag {lag}", 
                                   "Model converged and parameters were estimated.", 
                                   {"order": (1, d_order, 1), "aic": model.aic, "p_value": pval}, 
                                   outcome_text)
            
            model_execution_details.append({
                "Region": region, 
                "Lag": lag, 
                "Model_Type": "SARIMAX",
                "Status": "Success", 
                "Reason": "N/A"
            })
        except Exception as e:
            error_text = f"Failed to fit SARIMAX for {region} at lag {lag}"
            governance.log_event("MODELING", error_text, 
                                {"region": region, "lag": lag, "error": str(e)}, "ERROR")
            governance.log_decision("MODEL_FIT_FAILED", error_text, 
                                   f"An exception occurred during model fitting.", 
                                   {"error": str(e)}, "Failed")
            
            model_execution_details.append({
                "Region": region, 
                "Lag": lag, 
                "Model_Type": "SARIMAX",
                "Status": "Failed", 
                "Reason": str(e)
            })
            continue
    
    # Fit VAR model if sufficient data
    if len(analysis_data) > 60:  # Need sufficient data for VAR
        try:
            # Prepare data for VAR
            var_data = analysis_data[["Death_rate_100k"] + exogs].dropna()
            
            # Fit VAR model
            var_model, var_lag = fit_var_model(var_data, maxlags=15, ic='aic')
            
            if var_model is not None:
                # Get impulse response functions
                irf = var_model.irf(10)
                
                # Store results
                results.append({
                    "Region": region,
                    "Lag": var_lag,
                    "D_Order": 0,
                    "Model_Type": "VAR",
                    "Effect": np.nan,  # VAR doesn't have a single effect parameter
                    "p_value": np.nan,
                    "AIC": var_model.aic,
                    "RMSE": np.nan,  # VAR has multiple equations
                    "Residuals_white": np.nan,
                    "Lag_Selection_Method": "AIC",
                    "Vaccination_Start_Date": str(vacc_start_date) if pd.notna(vacc_start_date) else None,
                    "Analysis_Period_Days": len(analysis_data)
                })
                
                fitted_models[region]["VAR"] = var_model
                
                governance.log_decision("MODEL_FIT_SUCCESS", f"VAR model fitted for {region} with lag {var_lag}", 
                                       "VAR model converged and parameters were estimated.", 
                                       {"aic": var_model.aic, "lag": var_lag}, 
                                       f"AIC: {var_model.aic:.2f}")
                
                model_execution_details.append({
                    "Region": region,
                    "Lag": var_lag,
                    "Model_Type": "VAR",
                    "Status": "Success",
                    "Reason": "N/A"
                })
        except Exception as e:
            error_text = f"Failed to fit VAR for {region}"
            governance.log_event("MODELING", error_text, 
                                {"region": region, "error": str(e)}, "ERROR")
            governance.log_decision("MODEL_FIT_FAILED", error_text, 
                                   f"An exception occurred during VAR fitting.", 
                                   {"error": str(e)}, "Failed")
            
            model_execution_details.append({
                "Region": region,
                "Lag": np.nan,
                "Model_Type": "VAR",
                "Status": "Failed",
                "Reason": str(e)
            })
    
    # Fit VECM model if cointegration is detected
    cointegrated_exogs = [exog for exog in exogs 
                         if exog in cointegration_results and cointegration_results[exog]["is_cointegrated"]]
    
    if cointegrated_exogs and len(analysis_data) > 60:
        try:
            # Prepare data for VECM
            vecm_data = analysis_data[["Death_rate_100k"] + cointegrated_exogs].dropna()
            
            # Fit VECM model
            vecm_model = fit_vecm_model(vecm_data, deterministic='ci')
            
            if vecm_model is not None:
                # Store results
                results.append({
                    "Region": region,
                    "Lag": np.nan,  # VECM doesn't use the same lag concept
                    "D_Order": 0,
                    "Model_Type": "VECM",
                    "Effect": np.nan,
                    "p_value": np.nan,
                    "AIC": vecm_model.aic,
                    "RMSE": np.nan,
                    "Residuals_white": np.nan,
                    "Lag_Selection_Method": "Cointegration",
                    "Vaccination_Start_Date": str(vacc_start_date) if pd.notna(vacc_start_date) else None,
                    "Analysis_Period_Days": len(analysis_data)
                })
                
                fitted_models[region]["VECM"] = vecm_model
                
                governance.log_decision("MODEL_FIT_SUCCESS", f"VECM model fitted for {region}", 
                                       "VECM model converged and parameters were estimated.", 
                                       {"aic": vecm_model.aic, "cointegrated_vars": cointegrated_exogs}, 
                                       f"AIC: {vecm_model.aic:.2f}")
                
                model_execution_details.append({
                    "Region": region,
                    "Lag": np.nan,
                    "Model_Type": "VECM",
                    "Status": "Success",
                    "Reason": "N/A"
                })
        except Exception as e:
            error_text = f"Failed to fit VECM for {region}"
            governance.log_event("MODELING", error_text, 
                                {"region": region, "error": str(e)}, "ERROR")
            governance.log_decision("MODEL_FIT_FAILED", error_text, 
