    fig.update_yaxes(title_text="Anomaly Count", row=2, col=1)
    fig.update_yaxes(title_text="Death Rate per 100k", row=2, col=2)
    fig.update_yaxes(title_text="Death Rate per 100k", row=3, col=2)
    
