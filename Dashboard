# ============================================================
# CALLBACK
# ============================================================
@app.callback(
    Output("fig", "figure"),
    Output("text", "children"),
    Output("policy-simulation-results", "children"),
    Input("region", "value"),
    Input("lag", "value"),
    Input("policy", "value")
)
def update(region, lag, policy):

    dfr = df.copy() if region == "ALL" else df[df["WHO_region"] == region]

    # ---------- LAG ANALYSIS ----------
    lags = range(0, MAX_LAG + 1, 7)
    corrs = []

    for l in lags:
        corr = dfr["Death_rate_100k"].corr(
            dfr[vacc_col].shift(l) if vacc_col else pd.Series([np.nan] * len(dfr))
        )
        corrs.append(corr)

    # ---------- ENHANCED POLICY EFFECT ----------
    sim_df, metrics = simulate_policy_change(dfr, vacc_col, policy, lag)
    
    # ---------- TOP ANOMALY REGIONS ----------
    top_anom = (
        df.groupby("WHO_region")["is_anomaly"]
          .sum()
          .sort_values(ascending=False)
          .head(5)
    )
    
    # ---------- ANOMALY TYPES ----------
    gov_anom_count = dfr["is_gov_anomaly"].sum()
    z_anom_count = dfr["is_z_anomaly"].sum()

    # ---------- POLICY SIMULATION RESULTS ----------
    policy_results = html.Div([
        html.H4("Policy Simulation Results", style={"color": "#333", "marginBottom": "15px"}),
        html.Div(style={"display": "flex", "gap": "20px"}, children=[
            # Left column - Metrics
            html.Div(style={"width": "50%"}, children=[
                html.P(f"Model Type: {metrics['model_type']}", style={"fontWeight": "bold"}),
                html.P(f"Correlation: {metrics['correlation']:.3f} (p-value: {metrics['p_value']:.3f})"),
                html.P(f"R-squared: {metrics['r_squared']:.3f}"),
                html.P(f"Lag Period: {metrics['lag_days']} days"),
                html.Hr(),
                html.P(f"Base Death Rate: {metrics['base_death_rate']:.2f} per 100k"),
                html.P(f"Simulated Death Rate: {metrics['simulated_death_rate']:.2f} per 100k"),
                html.P(f"Percent Change: {metrics['percent_change']:.2f}%", 
                       style={"color": "green" if metrics['percent_change'] < 0 else "red", "fontWeight": "bold"}),
                html.P(f"Estimated Deaths Averted: {metrics['deaths_averted']:.0f}", 
                       style={"color": "green", "fontWeight": "bold"}),
            ]),
            # Right column - Explanation
            html.Div(style={"width": "50%"}, children=[
                html.H5("Explanation of Simulation:", style={"marginBottom": "10px"}),
                html.P(f"This simulation models the effect of a {policy:+d}% change in vaccination rates on death rates, "
                       f"with a {lag}-day lag to account for the time needed for vaccinations to take effect."),
                html.P(f"The model uses historical data to establish the relationship between vaccination and death rates. "
                       f"The correlation coefficient ({metrics['correlation']:.3f}) indicates the strength of this relationship."),
                html.P(f"The simulation predicts that a {policy:+d}% change in vaccination would lead to a "
                       f"{metrics['percent_change']:.2f}% change in death rates, potentially averting "
                       f"{metrics['deaths_averted']:.0f} deaths in the selected region(s)."),
                html.P(f"Confidence Interval: [{metrics['confidence_interval'][0]:.2f}, {metrics['confidence_interval'][1]:.2f}]",
                       style={"fontSize": "11px", "color": "#666"}),
            ])
        ])
    ])

    # ---------- FIGURE ----------
    fig = make_subplots(
        rows=3, cols=2,
        subplot_titles=[
            "Death Rate Over Time",
            "Vaccination Lag Sensitivity",
            "Top Regions by Anomalies",
            "Policy Simulation Effect",
            "", # <-- Empty title for pie chart
            "Vaccination vs Death Rate (Scatter)"
        ],
        specs=[
            [{"secondary_y": True}, {"type": "scatter"}],
            [{"type": "bar"}, {"type": "scatter"}],
            [{"type": "pie"}, {"type": "scatter"}]
        ],
        vertical_spacing=0.15
    )

    # Plot 1: Death Rate Over Time
    fig.add_trace(
        go.Scatter(
            x=dfr["date"],
            y=dfr["Death_rate_100k"],
            mode="lines",
            name="Death Rate",
            line=dict(width=2)
        ), row=1, col=1, secondary_y=False
    )
    if vacc_col:
        fig.add_trace(
            go.Scatter(
                x=dfr["date"],
                y=dfr[vacc_col],
                mode="lines",
                name="Vaccination Rate",
                line=dict(width=2, dash="dot"),
                yaxis="y2"
            ), row=1, col=1, secondary_y=True
        )
    fig.add_trace(
        go.Scatter(
            x=dfr[dfr["is_anomaly"]]["date"],
            y=dfr[dfr["is_anomaly"]]["Death_rate_100k"],
            mode="markers",
            marker=dict(color="red", size=5),
            name="Anomalies"
        ), row=1, col=1, secondary_y=False
    )

    # Plot 2: Lag Correlation
    fig.add_trace(
        go.Scatter(x=list(lags), y=corrs, name="Lag Correlation"),
        row=1, col=2
    )
    fig.add_vline(x=lag, line_dash="dash", row=1, col=2)

    # Plot 3: Top Anomaly Regions
    fig.add_trace(
        go.Bar(x=top_anom.index, y=top_anom.values, name="Anomaly Count", marker_color='crimson'),
        row=2, col=1
    )

    # Plot 4: Policy Simulation with Confidence Interval
    fig.add_trace(
        go.Scatter(
            x=dfr["date"],
            y=dfr["Death_rate_100k"],
            mode="lines",
            name="Observed Death Rate",
            line=dict(color="blue")
        ), row=2, col=2
    )
    if vacc_col:
        fig.add_trace(
            go.Scatter(
                x=sim_df["date"],
                y=sim_df["Death_rate_100k_sim"],
                mode="lines",
                name=f"Simulated ({policy:+d}% Vaccination)",
                line=dict(color="green", dash="dash")
            ), row=2, col=2
        )
        # Add confidence interval if available
        if "Death_rate_100k_sim_lower" in sim_df.columns:
            fig.add_trace(
                go.Scatter(
                    x=sim_df["date"],
                    y=sim_df["Death_rate_100k_sim_upper"],
                    mode="lines",
                    line=dict(width=0),
                    showlegend=False
                ), row=2, col=2
            )
            fig.add_trace(
                go.Scatter(
                    x=sim_df["date"],
                    y=sim_df["Death_rate_100k_sim_lower"],
                    mode="lines",
                    line=dict(width=0),
                    fill="tonexty",
                    fillcolor="rgba(0,255,0,0.2)",
                    name="95% Confidence Interval",
                    showlegend=True
                ), row=2, col=2
            )

    # Plot 5: Anomaly Breakdown
    fig.add_trace(
        go.Pie(
            labels=["Normal", "Governance Anomaly", "Z-score Anomaly"],
            values=[
                len(dfr) - dfr["is_anomaly"].sum(),
                gov_anom_count,
                z_anom_count
            ],
            hole=0.3,
            name="Anomaly Types"
        ), row=3, col=1
    )

    # Plot 6: Vaccination vs Death Rate Scatter
    if vacc_col:
        df_lag = dfr.copy()
        df_lag["vacc_lag"] = df_lag[vacc_col].shift(lag)
        df_scatter = df_lag.dropna(subset=["vacc_lag", "Death_rate_100k"])
        
        fig.add_trace(
            go.Scatter(
                x=df_scatter["vacc_lag"],
                y=df_scatter["Death_rate_100k"],
                mode="markers",
                name="Vaccination vs Death Rate",
                marker=dict(
                    color=df_scatter["is_anomaly"],
                    colorscale=[[0, "blue"], [1, "red"]],
                    size=5,
                    opacity=0.7,
                    colorbar=dict(
                        title="Anomaly",
                        x=1.02,
                        y=0.5,
                        yanchor="middle",
                        len=0.5,
                        xref='paper',
                        yref='paper'
                    )
                )
            ), row=3, col=2
        )
        
        # Add regression line
        if len(df_scatter) > 10:
            slope, intercept, r_value, p_value, std_err = stats.linregress(
                df_scatter["vacc_lag"], df_scatter["Death_rate_100k"]
            )
            x_range = np.array([df_scatter["vacc_lag"].min(), df_scatter["vacc_lag"].max()])
            y_range = intercept + slope * x_range
            fig.add_trace(
                go.Scatter(
                    x=x_range, y=y_range,
                    mode="lines",
                    line=dict(color="red", width=2),
                    name="Regression Line"
                ), row=3, col=2
            )
    else:
        fig.add_annotation(
            text="No vaccination data available for this analysis",
            xref="x6 domain", yref="y6 domain",
            x=0.5, y=0.5, xanchor='center', yanchor='middle',
            showarrow=False, font=dict(size=16)
        )

    # Add side title for pie chart
    fig.add_annotation(
        text="Anomaly Breakdown",
        xref="x5 domain", yref="y5 domain",
        x=-0.15, y=0.5,
        xanchor='right', yanchor='middle',
        showarrow=False,
        font=dict(size=14, family="Arial, sans-serif"),
        textangle=-90
    )

    # Add explanations for each chart
    annotations = [
        ("Shows the trend of death rates and highlights statistical outliers.", 1, 1),
        ("Displays the correlation between vaccination and death rates over different time lags.", 1, 2),
        ("Ranks regions by the total number of detected anomalies.", 2, 1),
        ("Simulates the potential impact of policy changes on death rates.", 2, 2),
        ("", 3, 1), # No annotation for pie chart
        ("Illustrates the relationship between vaccination rates and death rates.", 3, 2)
    ]

    for text, row, col in annotations:
        if text:
            fig.add_annotation(
                text=text,
                xref=f"x{row*col + col} domain",
                yref=f"y{row*col + col} domain",
