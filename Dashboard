                font=dict(size=11, color="grey"),
                row=row, col=col
            )

    fig.update_layout(
        height=1000,
        title_text=f"COVID-19 Dashboard - {region if region != 'ALL' else 'All Regions'}",
        template="plotly_white",
        legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1)
    )
    
