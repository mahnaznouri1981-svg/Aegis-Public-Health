regions = sorted(df["WHO_region"].dropna().unique())
default_region = regions[0]

# ============================================================
# LOAD GOVERNANCE DATA (FROM CODE 2)
# ============================================================
gov_files = sorted(glob(os.path.join(GOV_JSON_DIR, "*.json")))
gov = {}
anomalies = []

if gov_files:
    try:
        with open(gov_files[-1], "r", encoding="utf-8") as f:
            gov = json.load(f)
            anomalies = gov.get("top_anomalies", [])
        print(f"Governance data loaded from latest file: {os.path.basename(gov_files[-1])}")
    except Exception as e:
        print(f"Error loading governance data: {e}")
else:
    print("No governance files found, using internal anomaly detection only")

# Mark anomalies from governance data
df["is_gov_anomaly"] = False
for a in anomalies:
    if "WHO_region" in a and "date" in a:
        mask = (
            (df["WHO_region"] == a["WHO_region"]) &
            (df["date"] == pd.to_datetime(a["date"]))
        )
        df.loc[mask, "is_gov_anomaly"] = True

# ============================================================
# ENHANCED ANOMALY DETECTION (COMBINING BOTH APPROACHES)
# ============================================================
# Z-score based anomaly detection
df["death_z"] = (
    df.groupby("WHO_region")["Death_rate_100k"]
      .transform(lambda x: (x - x.mean()) / x.std(ddof=0))
)
df["is_z_anomaly"] = df["death_z"].abs() > 3

# Combine anomaly flags
df["is_anomaly"] = df["is_gov_anomaly"] | df["is_z_anomaly"]

# ============================================================
# VACCINATION COLUMN DETECTION (FROM CODE 2)
# ============================================================
if "fully_vaccinated_100k" in df.columns:
    vacc_col = "fully_vaccinated_100k"
elif "persons_vaccinated_100k" in df.columns:
    vacc_col = "persons_vaccinated_100k"
elif "vaccine_doses_administered_100k" in df.columns:
    vacc_col = "vaccine_doses_administered_100k"
else:
    vacc_col = None
    print("Warning: No vaccination column found")

# ============================================================
# PRECOMPUTE LAG EFFECT DATA (FROM CODE 2)
# ============================================================
MAX_LAG = 120
lag_results = []

if vacc_col:
    for region in regions:
        dfr = df[df["WHO_region"] == region].copy()
        dfr = dfr.dropna(subset=["Death_rate_100k", vacc_col])

        for lag in range(0, MAX_LAG + 1, 7):  # Use 7-day steps
            dfr[f"vacc_lag_{lag}"] = dfr[vacc_col].shift(lag)
            corr = dfr[["Death_rate_100k", f"vacc_lag_{lag}"]].corr().iloc[0, 1]
            lag_results.append({
                "WHO_region": region,
                "lag": lag,
                "effect": corr if not np.isnan(corr) else 0.0
            })
else:
    # Fallback: flat zero effects
    for region in regions:
        for lag in range(0, MAX_LAG + 1, 7):
            lag_results.append({
                "WHO_region": region,
                "lag": lag,
                "effect": 0.0
            })

lag_df = pd.DataFrame(lag_results)

# ============================================================
# ENHANCED POLICY SIMULATION FUNCTION
# ============================================================
def simulate_policy_change(dfr, vacc_col, policy_change, lag_days=30):
    """
    Simulate the effect of a policy change on death rates with enhanced methodology
    
    Args:
        dfr: DataFrame with the data
        vacc_col: Column name for vaccination data
        policy_change: Percentage change in vaccination rate (positive for increase)
        lag_days: Number of days to lag the vaccination effect
    
    Returns:
        Tuple of (simulated_df, metrics_dict)
    """
    if vacc_col is None:
        # Return original data with no effect if no vaccination data
        metrics = {
            "model_type": "No vaccination data",
            "correlation": 0,
            "p_value": 1,
            "base_death_rate": dfr["Death_rate_100k"].mean(),
            "simulated_death_rate": dfr["Death_rate_100k"].mean(),
            "percent_change": 0,
            "deaths_averted": 0,
            "confidence_interval": (0, 0)
        }
        return dfr, metrics
    
    sim_df = dfr.copy()
    
    # Apply policy change to vaccination rate
    sim_df[vacc_col] *= (1 + policy_change/100)
    
    # Calculate the effect on death rate based on historical correlation
    try:
        # Use a linear model based on historical data with lag
        dfr_clean = dfr.dropna(subset=[vacc_col, "Death_rate_100k"])
        
        if len(dfr_clean) > 10:
            # Apply lag to vaccination data
            dfr_clean[f"{vacc_col}_lag"] = dfr_clean[vacc_col].shift(lag_days)
            dfr_clean = dfr_clean.dropna(subset=[f"{vacc_col}_lag", "Death_rate_100k"])
            
            # Calculate correlation and p-value
            corr, p_value = stats.pearsonr(dfr_clean[f"{vacc_col}_lag"], dfr_clean["Death_rate_100k"])
            
            # Fit linear model
            slope, intercept, r_value, p_value, std_err = stats.linregress(
                dfr_clean[f"{vacc_col}_lag"], 
                dfr_clean["Death_rate_100k"]
            )
            
            # Apply the model to simulate new death rates
            sim_df[f"{vacc_col}_lag"] = sim_df[vacc_col].shift(lag_days)
            sim_df["Death_rate_100k_sim"] = intercept + slope * sim_df[f"{vacc_col}_lag"]
            
            # Calculate confidence interval for the prediction
            # Standard error of prediction
            y_pred = intercept + slope * dfr_clean[f"{vacc_col}_lag"]
            residuals = dfr_clean["Death_rate_100k"] - y_pred
            mse = np.sum(residuals**2) / (len(dfr_clean) - 2)
            std_pred = np.sqrt(mse * (1 + 1/len(dfr_clean) + (dfr_clean[f"{vacc_col}_lag"] - dfr_clean[f"{vacc_col}_lag"].mean())**2 / np.sum((dfr_clean[f"{vacc_col}_lag"] - dfr_clean[f"{vacc_col}_lag"].mean())**2)))
            
            # 95% confidence interval
            ci = 1.96 * std_pred.mean()
            ci_lower = sim_df["Death_rate_100k_sim"] - ci
            ci_upper = sim_df["Death_rate_100k_sim"] + ci
            
            # Ensure death rates don't go negative
            sim_df["Death_rate_100k_sim"] = sim_df["Death_rate_100k_sim"].clip(lower=0)
            sim_df["Death_rate_100k_sim_lower"] = ci_lower.clip(lower=0)
            sim_df["Death_rate_100k_sim_upper"] = ci_upper
            
            # Calculate metrics
            base_death_rate = dfr["Death_rate_100k"].mean()
            simulated_death_rate = sim_df["Death_rate_100k_sim"].mean()
            percent_change = ((simulated_death_rate - base_death_rate) / base_death_rate) * 100
            
            # Estimate deaths averted (assuming population of 100k per data point)
            deaths_averted = (base_death_rate - simulated_death_rate) * len(dfr) / 100000
            
            metrics = {
                "model_type": "Linear regression with lag",
                "correlation": corr,
                "p_value": p_value,
                "r_squared": r_value**2,
                "base_death_rate": base_death_rate,
                "simulated_death_rate": simulated_death_rate,
                "percent_change": percent_change,
                "deaths_averted": deaths_averted,
                "confidence_interval": (ci_lower.mean(), ci_upper.mean()),
                "lag_days": lag_days
            }
        else:
            # If insufficient data, use a simple proportional model
            sim_df["Death_rate_100k_sim"] = sim_df["Death_rate_100k"] * (1 - policy_change/200)
            base_death_rate = dfr["Death_rate_100k"].mean()
            simulated_death_rate = sim_df["Death_rate_100k_sim"].mean()
            percent_change = ((simulated_death_rate - base_death_rate) / base_death_rate) * 100
            
            metrics = {
                "model_type": "Simple proportional model (insufficient data)",
                "correlation": 0,
                "p_value": 1,
                "r_squared": 0,
                "base_death_rate": base_death_rate,
                "simulated_death_rate": simulated_death_rate,
                "percent_change": percent_change,
                "deaths_averted": (base_death_rate - simulated_death_rate) * len(dfr) / 100000,
                "confidence_interval": (0, 0),
                "lag_days": lag_days
            }
    except Exception as e:
        # Fallback to simple proportional model
        sim_df["Death_rate_100k_sim"] = sim_df["Death_rate_100k"] * (1 - policy_change/200)
        base_death_rate = dfr["Death_rate_100k"].mean()
        simulated_death_rate = sim_df["Death_rate_100k_sim"].mean()
        percent_change = ((simulated_death_rate - base_death_rate) / base_death_rate) * 100
        
        metrics = {
            "model_type": f"Simple proportional model (error: {str(e)})",
            "correlation": 0,
            "p_value": 1,
            "r_squared": 0,
            "base_death_rate": base_death_rate,
            "simulated_death_rate": simulated_death_rate,
            "percent_change": percent_change,
            "deaths_averted": (base_death_rate - simulated_death_rate) * len(dfr) / 100000,
            "confidence_interval": (0, 0),
            "lag_days": lag_days
        }
    
    return sim_df, metrics

