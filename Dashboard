            html.Li(f"Lag Analysis: The strongest correlation between vaccination and reduced death rates is observed at a lag of approximately {lag} days."),
            html.Li(f"Policy Simulation: A {policy:+d}% change in vaccination coverage is projected to change the average death rate from {metrics['base_death_rate']:.2f} to {metrics['simulated_death_rate']:.2f} per 100k."),
            html.Li(f"Anomaly Detection: Found {dfr['is_anomaly'].sum()} anomalies in the selected data. This includes {gov_anom_count} from governance reports and {z_anom_count} from statistical analysis (Z-score)."),
            html.Li(f"Data Source: Aggregated regional data with governance validation.")
        ])
    ])

    return fig, text, policy_results
